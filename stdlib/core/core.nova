# NOVA Standard Library - Core Module

// Core type definitions and basic functions
// This module is automatically imported in all NOVA programs

/// Print a value to stdout
fn print<T>(value: T) {
    // Implemented via runtime FFI
    __builtin_print(value);
}

/// Print a value with newline
fn println<T>(value: T) {
    print(value);
    print("\n");
}

/// Get the type of a value
fn typeof<T>(value: T) -> String {
    __builtin_typeof(value)
}

/// Convert a value to string
fn tostring<T>(value: T) -> String {
    __builtin_tostring(value)
}

/// Panic with a message
fn panic(message: String) -> ! {
    __builtin_panic(message)
}

/// Assert a condition is true
fn assert(condition: bool, message: String) {
    if !condition {
        panic(message);
    }
}

/// Identity function (returns argument unchanged)
fn id<T>(x: T) -> T {
    x
}

/// Compose two functions
fn compose<A, B, C>(f: fn(B) -> C, g: fn(A) -> B) -> fn(A) -> C {
    |x| f(g(x))
}

/// Pipe operator - pass value through function
fn pipe<A, B>(value: A, f: fn(A) -> B) -> B {
    f(value)
}

/// Range iterator (0..n)
fn range(start: int, end: int) -> Range {
    Range { start, end, current: start }
}

/// Range struct for iteration
struct Range {
    start: int,
    end: int,
    current: int,
}

impl Range {
    fn next(&mut self) -> Option<int> {
        if self.current < self.end {
            let value = self.current;
            self.current = self.current + 1;
            Some(value)
        } else {
            None
        }
    }
    
    fn reset(&mut self) {
        self.current = self.start;
    }
}

/// Array utilities
fn array_len<T>(arr: [T]) -> int {
    __builtin_array_len(arr)
}

fn array_push<T>(arr: &mut [T], value: T) {
    __builtin_array_push(arr, value)
}

fn array_pop<T>(arr: &mut [T]) -> Option<T> {
    __builtin_array_pop(arr)
}

fn array_get<T>(arr: [T], index: int) -> Option<T> {
    if index >= 0 && index < array_len(arr) {
        Some(arr[index])
    } else {
        None
    }
}

fn array_set<T>(arr: &mut [T], index: int, value: T) -> bool {
    if index >= 0 && index < array_len(arr) {
        arr[index] = value;
        true
    } else {
        false
    }
}

/// String utilities
fn strlen(s: String) -> int {
    __builtin_strlen(s)
}

fn strcat(a: String, b: String) -> String {
    __builtin_strcat(a, b)
}

fn strcmp(a: String, b: String) -> int {
    __builtin_strcmp(a, b)
}

fn substr(s: String, start: int, len: int) -> String {
    __builtin_substr(s, start, len)
}

/// Math constants
const PI: float = 3.141592653589793;
const E: float = 2.718281828459045;
const PHI: float = 1.618033988749895;

/// Absolute value
fn abs(x: int) -> int {
    if x < 0 { -x } else { x }
}

fn fabs(x: float) -> float {
    if x < 0.0 { -x } else { x }
}

/// Min/max functions
fn min(a: int, b: int) -> int {
    if a < b { a } else { b }
}

fn max(a: int, b: int) -> int {
    if a > b { a } else { b }
}

fn fmin(a: float, b: float) -> float {
    if a < b { a } else { b }
}

fn fmax(a: float, b: float) -> float {
    if a > b { a } else { b }
}

/// Clamp a value between min and max
fn clamp(x: int, min_val: int, max_val: int) -> int {
    if x < min_val { min_val }
    else if x > max_val { max_val }
    else { x }
}

/// Sign function: returns -1, 0, or 1
fn sign(x: int) -> int {
    if x < 0 { -1 }
    else if x > 0 { 1 }
    else { 0 }
}

/// Power function (integer exponent)
fn pow(base: int, exp: int) -> int {
    if exp == 0 { 1 }
    else if exp == 1 { base }
    else if exp < 0 { 
        panic("Negative exponent not supported for integer power")
    }
    else {
        let mut result = 1;
        let mut i = 0;
        while i < exp {
            result = result * base;
            i = i + 1;
        }
        result
    }
}

/// Factorial
fn factorial(n: int) -> int {
    if n <= 1 { 1 }
    else { n * factorial(n - 1) }
}

/// Fibonacci
fn fibonacci(n: int) -> int {
    if n <= 0 { 0 }
    else if n == 1 { 1 }
    else { fibonacci(n - 1) + fibonacci(n - 2) }
}

/// GCD using Euclidean algorithm
fn gcd(a: int, b: int) -> int {
    let mut x = a;
    let mut y = b;
    while y != 0 {
        let temp = y;
        y = x % y;
        x = temp;
    }
    x
}

/// LCM
fn lcm(a: int, b: int) -> int {
    (a * b) / gcd(a, b)
}

/// Check if number is even
fn is_even(n: int) -> bool {
    n % 2 == 0
}

/// Check if number is odd
fn is_odd(n: int) -> bool {
    n % 2 != 0
}

/// Check if number is prime
fn is_prime(n: int) -> bool {
    if n < 2 { false }
    else if n == 2 { true }
    else if n % 2 == 0 { false }
    else {
        let mut i = 3;
        while i * i <= n {
            if n % i == 0 { return false; }
            i = i + 2;
        }
        true
    }
}

/// Sum of array
fn sum(arr: [int]) -> int {
    let mut total = 0;
    let mut i = 0;
    while i < array_len(arr) {
        total = total + arr[i];
        i = i + 1;
    }
    total
}

/// Product of array
fn product(arr: [int]) -> int {
    let mut total = 1;
    let mut i = 0;
    while i < array_len(arr) {
        total = total * arr[i];
        i = i + 1;
    }
    total
}

/// Find element in array
fn find<T>(arr: [T], predicate: fn(T) -> bool) -> Option<int> {
    let mut i = 0;
    while i < array_len(arr) {
        if predicate(arr[i]) {
            return Some(i);
        }
        i = i + 1;
    }
    None
}

/// Filter array
fn filter<T>(arr: [T], predicate: fn(T) -> bool) -> [T] {
    let mut result: [T] = [];
    let mut i = 0;
    while i < array_len(arr) {
        if predicate(arr[i]) {
            array_push(result, arr[i]);
        }
        i = i + 1;
    }
    result
}

/// Map array
fn map<A, B>(arr: [A], f: fn(A) -> B) -> [B] {
    let mut result: [B] = [];
    let mut i = 0;
    while i < array_len(arr) {
        array_push(result, f(arr[i]));
        i = i + 1;
    }
    result
}

/// Reduce/fold array
fn reduce<T, U>(arr: [T], initial: U, f: fn(U, T) -> U) -> U {
    let mut acc = initial;
    let mut i = 0;
    while i < array_len(arr) {
        acc = f(acc, arr[i]);
        i = i + 1;
    }
    acc
}

/// Reverse array
fn reverse<T>(arr: &mut [T]) {
    let len = array_len(arr);
    let mut i = 0;
    while i < len / 2 {
        let temp = arr[i];
        arr[i] = arr[len - 1 - i];
        arr[len - 1 - i] = temp;
        i = i + 1;
    }
}

/// Sort array (simple bubble sort)
fn sort(arr: &mut [int]) {
    let len = array_len(arr);
    let mut swapped = true;
    while swapped {
        swapped = false;
        let mut i = 1;
        while i < len {
            if arr[i - 1] > arr[i] {
                let temp = arr[i - 1];
                arr[i - 1] = arr[i];
                arr[i] = temp;
                swapped = true;
            }
            i = i + 1;
        }
    }
}

/// Linear search
fn linear_search(arr: [int], target: int) -> Option<int> {
    let mut i = 0;
    while i < array_len(arr) {
        if arr[i] == target {
            return Some(i);
        }
        i = i + 1;
    }
    None
}

/// Binary search (requires sorted array)
fn binary_search(arr: [int], target: int) -> Option<int> {
    let mut low = 0;
    let mut high = array_len(arr) - 1;
    
    while low <= high {
        let mid = (low + high) / 2;
        if arr[mid] == target {
            return Some(mid);
        } else if arr[mid] < target {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    None
}

/// Random number generator seed
static RAND_SEED: int = 12345;

/// Set random seed
fn srand(seed: int) {
    RAND_SEED = seed;
}

/// Generate pseudo-random number
fn rand() -> int {
    RAND_SEED = (RAND_SEED * 1103515245 + 12345) % 2147483648;
    RAND_SEED
}

/// Random number in range [min, max]
fn rand_range(min: int, max: int) -> int {
    min + (rand() % (max - min + 1))
}

/// Sleep for milliseconds (via runtime)
fn sleep(ms: int) {
    __builtin_sleep(ms)
}

/// Get current time in milliseconds
fn now() -> int {
    __builtin_now()
}

/// Exit program with code
fn exit(code: int) -> ! {
    __builtin_exit(code)
}

/// Environment variable access
fn getenv(name: String) -> Option<String> {
    __builtin_getenv(name)
}

/// Command line arguments
fn args() -> [String] {
    __builtin_args()
}

/// Working directory
fn cwd() -> String {
    __builtin_cwd()
}

/// Change directory
fn chdir(path: String) -> bool {
    __builtin_chdir(path)
}
