fn factorial(n: int) -> int {
    if n <= 1 {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

fn main() {
    // Test recursive function
    print("Factorial of 5:");
    print(factorial(5));
    
    // Test for loop with range
    print("Counting:");
    for i in 0..5 {
        print(i);
    }
    
    // Test while loop
    let j: int = 0;
    while j < 3 {
        print(j);
        j = j + 1;
    }
    
    // Test if-else
    let x: int = 10;
    if x > 5 {
        print("x is greater than 5");
    } else {
        print("x is not greater than 5");
    }
    
    // Test float printing
    print(3.14159);
    
    // Test boolean printing
    print(true);
    print(false);
}
