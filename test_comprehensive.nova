fn factorial(n: int) -> int {
    if n <= 1 {
        1
    } else {
        n * factorial(n - 1)
    }
}

fn main() {
    print(factorial(5));
    
    for i in 0..5 {
        print(i);
    }
    
    let x = 10;
    while x > 0 {
        print(x);
        x = x - 1;
    }
    
    if true {
        print(100);
    } else {
        print(200);
    }
}
