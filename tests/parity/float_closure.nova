// A closure that takes and returns a float.
//
// The WebAssembly backend refused this until the table's types were keyed by signature shape: one
// type per arity assumed every parameter was an `i32`, so an `f64` closure had no type to name in
// `call_indirect`. A wrong key is a module that does not validate, so this program is the check.
fn apply(f: fn(float) -> float, x: float) -> float {
    f(x)
}

fn main() -> int {
    let scale = 2.5;
    let twice = |x| x * scale;

    print(twice(2.0));
    print(twice(0.5));
    print(apply(twice, 1.5));

    // An integer closure in the same program, so both shapes sit in one table.
    let bump = |n| n + 1;
    print(bump(41));
    return 0;
}
