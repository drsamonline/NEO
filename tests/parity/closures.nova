fn apply(f: fn(int) -> int, x: int) -> int {
    f(x)
}

fn make_adder(base: int) -> fn(int) -> int {
    |x| x + base
}

fn compose(f: fn(int) -> int, g: fn(int) -> int) -> fn(int) -> int {
    |x| f(g(x))
}

fn main() -> int {
    let inc = |x| x + 1;
    let dbl = |x| x * 2;
    let both = compose(inc, dbl);
    print(both(3));

    let base = 10;
    let add_base = |x| x + base;
    print(add_base(5));

    let add5 = make_adder(5);
    print(add5(3));

    print(apply(|n| n * 2, 21));

    let forty = || 42;
    print(forty());

    let greeting = "hi";
    let say = || greeting;
    print(say());

    let same = |s: string| s;
    print(same("ok"));

    let show = |s: string| print(s);
    show("done");

    let block = |s: string| {
        print(s);
        s
    };
    print(block("block"));
    return 0;
}
